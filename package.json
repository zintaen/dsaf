{
  "name": "@zintaen/dsaf",
  "version": "0.9.3",
  "description": "DSAF — Agent-native Design System & Product UX/UI Audit Framework with 1-command CLI checks, setup wizard, interactive HTML reports, Playwright/axe verification, token drift analysis, 3-vertex Figma triangulation, SARIF/CI gates, and automated updates.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dsaf": "bin/dsaf.mjs"
  },
  "files": [
    "bin/",
    "skill/",
    "README.md",
    "RELEASE_NOTES.md",
    "LICENSE"
  ],
  "keywords": [
    "design-system",
    "ux-audit",
    "ui-audit",
    "design-tokens",
    "dtcg",
    "wcag",
    "apca",
    "accessibility",
    "figma",
    "playwright",
    "agent-skill"
  ],
  "homepage": "https://zintaen.github.io/dsaf/",
  "bugs": {
    "url": "https://github.com/zintaen/dsaf/issues"
  },
  "license": "MIT",
  "author": "Stephen Cheng <zintaen@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zintaen/dsaf.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "node scripts/verify-repo.mjs",
    "test": "node scripts/verify-repo.mjs",
    "test:personas": "node skill/scripts/generate-personas.mjs --self-test",
    "test:fix": "node skill/scripts/fix-floor.mjs --self-test",
    "test:mcp": "node skill/scripts/mcp-server.mjs --self-test",
    "audit": "node skill/scripts/audit-pipeline.mjs",
    "check": "node bin/dsaf.mjs check",
    "setup": "node skill/scripts/setup.mjs",
    "update": "node skill/scripts/update.mjs",
    "update:check": "node skill/scripts/update.mjs --check",
    "personas": "node skill/scripts/generate-personas.mjs",
    "fix": "node skill/scripts/fix-floor.mjs",
    "mcp": "node skill/scripts/mcp-server.mjs",
    "recon": "node skill/scripts/recon.mjs",
    "audit:tokens": "node skill/scripts/audit-tokens.mjs",
    "audit:figma": "node skill/scripts/audit-figma-diff.mjs",
    "audit:runtime": "node skill/scripts/audit-runtime.mjs",
    "scorecard": "node skill/scripts/compute-scorecard.mjs",
    "audit:diff": "node skill/scripts/audit-diff.mjs",
    "guardrails": "node skill/scripts/generate-guardrails.mjs",
    "hook": "node skill/scripts/dsaf-hook.mjs",
    "install:skill": "node skill/scripts/install-skill.mjs",
    "doctor": "node skill/scripts/doctor.mjs"
  }
}
