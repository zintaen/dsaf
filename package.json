{
  "name": "dsaf",
  "version": "0.1.1",
  "description": "DSAF — Agent-native Design System & Product UX/UI Audit Framework with deterministic runtime verification, token drift analysis, Dual-Track drafts, CI guardrails, and closed-loop evolution.",
  "type": "module",
  "bin": {
    "dsaf": "./bin/dsaf.mjs"
  },
  "license": "MIT",
  "author": "Stephen Cheng <zintaen@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/zintaen/dsaf.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "node evolve/scripts/validate-isolation.mjs",
    "test": "node skill/scripts/check-integrity.mjs && node evolve/scripts/validate-isolation.mjs",
    "recon": "node skill/scripts/recon.mjs",
    "audit:tokens": "node skill/scripts/audit-tokens.mjs",
    "audit:runtime": "node skill/scripts/audit-runtime.mjs",
    "scorecard": "node skill/scripts/compute-scorecard.mjs",
    "audit:diff": "node skill/scripts/audit-diff.mjs",
    "guardrails": "node skill/scripts/generate-guardrails.mjs",
    "evolve:mine": "node evolve/scripts/mine-signals.mjs",
    "sync:skills": "node evolve/scripts/sync-skills.mjs --install-local"
  },
  "keywords": [
    "design-system",
    "ux-audit",
    "ui-audit",
    "design-tokens",
    "dtcg",
    "wcag",
    "apca",
    "accessibility",
    "agent-skill"
  ]
}
