{
  "name": "@zintaen/dsaf",
  "version": "0.3.0",
  "description": "DSAF — Agent-native Design System & Product UX/UI Audit Framework with deterministic runtime verification, token drift analysis, 3-vertex Figma triangulation, Dual-Track drafts, CI guardrails, and closed-loop evolution.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dsaf": "bin/dsaf.mjs"
  },
  "files": [
    "bin/",
    "skill/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "design-system",
    "ux-audit",
    "ui-audit",
    "design-tokens",
    "dtcg",
    "wcag",
    "apca",
    "accessibility",
    "figma",
    "playwright",
    "agent-skill"
  ],
  "homepage": "https://github.com/zintaen/dsaf#readme",
  "bugs": {
    "url": "https://github.com/zintaen/dsaf/issues"
  },
  "license": "MIT",
  "author": "Stephen Cheng <zintaen@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zintaen/dsaf.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "node evolve/scripts/validate-isolation.mjs",
    "test": "node skill/scripts/check-integrity.mjs && node evolve/scripts/validate-isolation.mjs",
    "audit": "node skill/scripts/audit-pipeline.mjs",
    "recon": "node skill/scripts/recon.mjs",
    "audit:tokens": "node skill/scripts/audit-tokens.mjs",
    "audit:figma": "node skill/scripts/audit-figma-diff.mjs",
    "audit:runtime": "node skill/scripts/audit-runtime.mjs",
    "scorecard": "node skill/scripts/compute-scorecard.mjs",
    "audit:diff": "node skill/scripts/audit-diff.mjs",
    "guardrails": "node skill/scripts/generate-guardrails.mjs",
    "evolve:mine": "node evolve/scripts/mine-signals.mjs",
    "sync:skills": "node evolve/scripts/sync-skills.mjs --install-local"
  }
}
